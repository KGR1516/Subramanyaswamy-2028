# --- Telegram (required for signals to actually send) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM debate (optional; deterministic fallback always works) ---
# Force a provider: claude_code | anthropic | openai. Leave blank to auto-detect.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Behaviour / tuning ---
BRAND=Bourse
CONFIDENCE_THRESHOLD=7
AGENT_DELAY=0.6
SHORTLIST_PER_BUCKET=4
PORT=5000
